<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.offwareapps.inkdrop"
    android:versionCode="2"
    android:versionName="0.1.1">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Reads the network's DNS servers, which the stages cannot find on Android. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Keeps the background refresh scheduled after the tablet restarts. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- The stages are programs under lib/, so they must sit on disk as files. -->
  <application
      android:label="ink-drop"
      android:icon="@mipmap/ic_launcher"
      android:extractNativeLibs="true"
      android:allowBackup="false"
      android:enableOnBackInvokedCallback="true"
      android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <service
        android:name=".RefreshJob"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="false" />
  </application>
</manifest>
